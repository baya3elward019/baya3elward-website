---
import Icon from './Icon.astro';
import profile from '../data/profile.json';
import { socialLabel } from '../lib/icons';

const year = new Date().getFullYear();
const socials = (profile.socials ?? []).filter((s) => s?.url);
---
<footer class="footer">
  <div class="wrap footer-inner">
    <p class="footer-line">
      <span class="muted">© {year} {profile.name}.</span>
      <span class="muted">Built with Astro, hosted on GitHub Pages.</span>
    </p>
    <ul class="footer-social">
      {
        socials.map((s) => (
          <li>
            <a class="icon-btn" href={s.url} target="_blank" rel="noopener noreferrer" aria-label={socialLabel[s.platform] ?? s.platform}>
              <Icon name={s.platform} size={18} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
